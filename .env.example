# Root of your health system's MyChart web portal (no trailing slash)
MYCHART_BASE_URL=https://mychart.nyulmc.org/mychart

# Optional: lets the server re-login automatically when the session expires.
# Leave unset to log in interactively (MYCHART_HEADLESS=false) instead.
MYCHART_USERNAME=
MYCHART_PASSWORD=

# Where the persistent browser profile (cookies, "trusted device") is stored
MYCHART_PROFILE_DIR=./profile

# Set to false to watch the browser (useful for first login / debugging)
MYCHART_HEADLESS=true

# Optional: path to a Chromium binary if Playwright's bundled one isn't installed
# MYCHART_CHROMIUM_PATH=

# HTTP mode only (npm run start:http): required bearer token and port
MCP_AUTH_TOKEN=
PORT=8787
